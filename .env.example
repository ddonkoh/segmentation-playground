# =============================================================================
# ShipSafe – Environment Variables Template
# 
# Documentation: See docs/features/environment-variables.md
# Quick Setup: See docs/get-started/installation.md
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# See: docs/get-started/configuration.md
# -----------------------------------------------------------------------------
# Application domain (no https://, no trailing slash)
# Used for email links, OAuth redirects, webhook URLs
NEXT_PUBLIC_APP_URL=localhost:3000

# Node environment
NODE_ENV=development


# =============================================================================
# Firebase Configuration
# See: docs/features/firebase-setup.md
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Client SDK (Public - Safe to expose to browser)
# Get these from: Firebase Console → Project Settings → General → Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=  # Optional: for Analytics

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Server-side only - KEEP PRIVATE!)
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# IMPORTANT: FIREBASE_PRIVATE_KEY must include \n for newlines (keep quotes)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=  # Optional: for Realtime Database


# =============================================================================
# Stripe Configuration
# See: docs/features/stripe-setup.md
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe API Keys
# Get these from: Stripe Dashboard → Developers → API keys
# Use sk_test_/pk_test_ for development, sk_live_/pk_live_ for production
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=  # Get from: Stripe Dashboard → Developers → Webhooks

# -----------------------------------------------------------------------------
# Stripe Price IDs
# Get these from: Stripe Dashboard → Products → Copy Price IDs
# Used by config.ts for pricing plans
# -----------------------------------------------------------------------------
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=


# =============================================================================
# Email Configuration (Resend)
# See: docs/features/email.md
# =============================================================================

# -----------------------------------------------------------------------------
# Resend API Key
# Get from: https://resend.com → API Keys
# ShipSafe uses Resend natively for all transactional emails
# -----------------------------------------------------------------------------
RESEND_API_KEY=


# =============================================================================
# Google OAuth (Optional)
# See: docs/features/authentication.md
# =============================================================================

# Get these from: Google Cloud Console → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =============================================================================
# Optional: Third-Party Services
# =============================================================================

# -----------------------------------------------------------------------------
# Crisp Chat (Optional)
# See: docs/get-started/configuration.md
# -----------------------------------------------------------------------------
CRISP_ID=  # Get from: Crisp Dashboard


# =============================================================================
# Development / Debugging (Optional)
# =============================================================================

# Enable verbose logging (development only)
DEBUG=false